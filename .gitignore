# ─── Secrets ────────────────────────────────────────────────────────────────
# .env holds the HuggingFace token and deployment identifiers. Copy .env.example instead.
# (config.json is committed: shared settings only, no secrets.)
.env
.env.*
!.env.example

# ─── Model weights & HF caches ─────────────────────────────────────────────
# Everything TRIBE v2 pulls lands under ./models (HF_HOME points here):
#   models/hub/     — model snapshots (V-JEPA2 ~14 GB, LLaMA 3.2-3B ~6 GB,
#                     Wav2Vec-BERT ~1 GB, tribev2 ckpt ~1 GB)
#   models/xet/     — hf_xet dedup chunk cache (can rival the download size)
#   models/assets/  — HF assets cache
#   models/datasets/— HF datasets cache
#   models/llama/   — explicit snapshot_download target (explore.ipynb cell 10)
# Plus tribev2's per-modality feature cache, which shares this folder.
/models/

# Stray caches if the env vars above are ever bypassed
.cache/
cache/
hub/

# ─── Neuroimaging atlas data ───────────────────────────────────────────────
# NILEARN_DATA points at data/nilearn (fsaverage5 + Destrieux, ~200 MB once
# fully fetched). Re-downloads automatically on first run.
/data/nilearn/

# Glasser HCP-MMP1 map files, downloaded once by load_model (~2.6 MB, SHA-256 checked).
/data/hcp_mmp/

# ─── Sample media and outputs ─────────────────────────────────────────────
# The ten public samples (videos, brain maps, CSVs, PDFs) are committed so a fresh
# clone is complete. Sub-folders (_test_clips/ and other local clips) stay local.
/data/videos/*/
# make_sample.py's intermediate result (samples.json holds the published copy):
/data/output/**/result.json
/data/output/**/*.npy
/data/output/**/*.png

# ─── Logs & temp ───────────────────────────────────────────────────────────
*.log
*.tmp
*.noaudio.mp4

# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ─── Jupyter ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/
.jupyter/

# ─── OS / editor ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ─── Local-only files ─────────────────────────────────────────────────────
*.local.*
*.local/

# ─── Tooling caches & build output ─────────────────────────────────────────
.ruff_cache/
.pytest_cache/
.coverage
dist/
build/

# ─── Terraform ─────────────────────────────────────────────────────────────
*.tfstate*
.terraform/
terraform.tfvars
*.tfplan
tfplan
backend.hcl
# Lambda zips and the ffprobe layer Terraform uploads
infra/terraform/.build/
