{
  "paths": {
    "models": "./models",
    "data": "./data"
  },
  "model": {
    "repo_id": "facebook/tribev2"
  },
  "hf_download_timeout": 300,
  "max_video_duration_seconds": 120,
  "max_upload_bytes": 300000000,
  "upload_retention_days": 30,
  "result_retention_days": 30,
  "upload": {
    "max_batch_files": 5,
    "max_waiting_jobs": 10
  },
  "research": {
    "curve_rewards_per_window": 5,
    "curve_reward_window_days": 30,
    "no_curve_days": 90,
    "dataset_retention_days": 1095,
    "curve_length_tolerance_s": 2,
    "curve_min_views": 1000,
    "min_curve_points": 20,
    "min_watch_spread": 0.02,
    "max_watch_ratio": 10
  },
  "response": {
    "colour_range": 0.5
  },
  "pricing": {
    "cents_per_block": 100,
    "block_seconds": 30
  },
  "visitor": {
    "pass_cents": 400,
    "initial_passes": 10,
    "gpu_warm_hours": 6,
    "adjust_deltas": [0, 5, 10],
    "grant_minutes": [0, 2, 5, 10]
  },
  "worker": {
    "heartbeat_seconds": 50,
    "max_job_minutes": 55
  },
  "queue": {
    "cancel_seconds": 15,
    "visibility_seconds": 1080,
    "dlq_visibility_seconds": 720,
    "max_receives": 2,
    "job_deadline_hours": 4
  },
  "report": {
    "model": "us.anthropic.claude-sonnet-4-6",
    "max_tokens": 20000,
    "max_tries": 3,
    "stale_minutes": 16
  },
  "db": {
    "backend": "data_api"
  },
  "auth": {
    "mode": "dev",
    "dev_user_id": "dev-user",
    "dev_email": "dev@localhost",
    "session_days": 30
  },
  "billing": {
    "starter_cents": 0,
    "invite_cents": 1000,
    "gpu_wait_grace_s": 300
  },
  "server": {
    "host": "127.0.0.1",
    "port": 5003
  }
}
