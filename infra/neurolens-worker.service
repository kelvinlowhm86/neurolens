# NeuroLens GPU worker (M2a §3). Baked into the image disabled; UserData enables and starts it.
[Unit]
Description=NeuroLens GPU worker
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/neurolens/app
EnvironmentFile=/opt/neurolens/env.conf
# The image build ran the pipeline as root with HOME=/root; anything the libraries keep under
# ~/.cache must be found here too (systemd sets no HOME for a root service).
Environment=HOME=/root
ExecStartPre=/opt/neurolens/bin/pull_code.sh
ExecStart=/opt/neurolens/venv/bin/python worker.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
