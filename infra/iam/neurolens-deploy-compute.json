{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ec2ReadAnything",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:GetLaunchTemplateData",
        "ec2:GetConsoleOutput"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Ec2CreateOnlyIfTaggedNeurolens",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "neurolens"
        }
      }
    },
    {
      "Sid": "Ec2CreateOnlyInsideNeurolensNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:*:vpc/*",
        "arn:aws:ec2:us-east-1:*:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "neurolens"
        }
      }
    },
    {
      "Sid": "Ec2TagWhileCreating",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "Null": {
          "ec2:CreateAction": "false"
        }
      }
    },
    {
      "Sid": "Ec2ChangeOrDeleteOnlyNeurolens",
      "Effect": "Allow",
      "Action": [
        "ec2:Delete*",
        "ec2:Modify*",
        "ec2:CreateTags",
        "ec2:CreateRoute",
        "ec2:ReplaceRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "neurolens"
        }
      }
    },
    {
      "Sid": "RemoveTheEc2Worker",
      "Effect": "Allow",
      "Action": [
        "ec2:DetachInternetGateway",
        "ec2:DisassociateAddress",
        "ec2:ReleaseAddress",
        "ec2:DeregisterImage",
        "autoscaling:DeleteAutoScalingGroup",
        "autoscaling:DeletePolicy"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "neurolens"
        }
      }
    },
    {
      "Sid": "RemoveTheEc2WorkerDescribes",
      "Effect": "Allow",
      "Action": [
        "autoscaling:DescribeAutoScalingGroups",
        "autoscaling:DescribePolicies"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ExplainOwnDenialsReadOnly",
      "Effect": "Allow",
      "Action": "sts:DecodeAuthorizationMessage",
      "Resource": "*"
    },
    {
      "Sid": "RolesOnlyNeurolensAndOnlyInsideTheBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::*:role/neurolens-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::${aws:PrincipalAccount}:policy/neurolens-role-boundary"
        }
      }
    },
    {
      "Sid": "RolesAndProfilesOnlyNeurolens",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::*:role/neurolens-*",
        "arn:aws:iam::*:instance-profile/neurolens-*"
      ]
    },
    {
      "Sid": "HandRolesOnlyToSageMaker",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/neurolens-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "sagemaker.amazonaws.com"
        }
      }
    },
    {
      "Sid": "HandRolesOnlyToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/neurolens-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "HandRolesOnlyToCodeBuild",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/neurolens-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "codebuild.amazonaws.com"
        }
      }
    },
    {
      "Sid": "AwsHelperRolesForAppScalingSageMakerCodeBuildAndRds",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "sagemaker.application-autoscaling.amazonaws.com",
            "sagemaker.amazonaws.com",
            "codebuild.amazonaws.com",
            "rds.amazonaws.com"
          ]
        }
      }
    }
  ]
}
