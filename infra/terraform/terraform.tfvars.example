# Copy to terraform.tfvars (gitignored) and fill in.
# S3 bucket names are unique across ALL of AWS, so make yours distinctive.
bucket_name = "neurolens-REPLACE-ME"

# Optional:
# queue_name      = "neurolens-jobs"
# allowed_origins = ["http://localhost:5003", "http://127.0.0.1:5003"]

# Region and the zones for Aurora's private subnets (at least two).
region = "us-east-1"
zones  = ["us-east-1a", "us-east-1b", "us-east-1c", "us-east-1d"]

# Where the GPU and Lambda alarms email you.
alert_email = "you@example.com"

# The web admin panel (empty: nobody can open it).
# admin_emails = ["you@example.com"]

# Contact address on the privacy and retention pages (empty: a GitHub repo link).
# contact_email = "you@example.com"

# The GPU is a SageMaker endpoint. Keep this empty for the first apply: infra/setup.sh uploads the
# model files to model-data/ first, then builds the image with infra/build_image.sh (it prints its
# digest), puts the digest here and applies again. Empty: no endpoint is created.
# worker_image   = "sha256:REPLACE-WITH-THE-BUILT-IMAGE-DIGEST"
# max_instances  = 1          # up to the account's GPU quota
# idle_stop_minutes = 7       # idle time before the last GPU stops
# log_retention_days = 90     # while developing; 14 once live

# Required: sign-in (section 2f).
# The Cognito page prefix (unique in the region, lowercase, no "aws", "amazon" or "cognito"),
# e.g. "neurolens-<something of yours>":
auth_domain_prefix = "neurolens-REPLACE-ME"
# The Google OAuth client's ID (not secret). Its secret lives in Parameter Store, stored once
# (infra/terraform/README.md section 0):
google_client_id = "1234567890-abc.apps.googleusercontent.com"
