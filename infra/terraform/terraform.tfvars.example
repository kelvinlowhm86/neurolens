# Copy to terraform.tfvars (gitignored) and fill in.
# S3 bucket names are unique across ALL of AWS, so make yours distinctive.
bucket_name = "neurolens-REPLACE-ME"

# Optional:
# queue_name      = "neurolens-jobs"
# allowed_origins = ["http://localhost:5003", "http://127.0.0.1:5003"]

# Region and the zones for Aurora's private subnets (at least two).
region = "us-east-1"
zones  = ["us-east-1a", "us-east-1b", "us-east-1c", "us-east-1d"]

# Where the GPU and Lambda alarms email you.
alert_email = "you@example.com"

# From M3e the GPU is a SageMaker endpoint. Build the image first (infra/build_image.sh prints
# its digest), then put the digest here and apply again. Empty: no endpoint is created.
# worker_image   = "sha256:REPLACE-WITH-THE-BUILT-IMAGE-DIGEST"
# max_instances  = 1          # stays 1; the account's GPU quota is 2
# log_retention_days = 90     # while developing; 14 once live

# M3b sign-in (§2a). The Cognito page prefix (unique in the region, lowercase, no "aws",
# "amazon" or "cognito"), e.g. "neurolens-<something of yours>":
# auth_domain_prefix = "neurolens-REPLACE-ME"
# The Google OAuth client's ID (not secret). Its secret lives in Parameter Store, stored once:
#   read -rs S && aws ssm put-parameter --name /neurolens/terraform/google_client_secret \
#     --type SecureString --value "$S" --overwrite && unset S
# google_client_id = "1234567890-abc.apps.googleusercontent.com"
