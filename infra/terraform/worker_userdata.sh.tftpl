#!/bin/bash
# NeuroLens worker first boot (M2a §4c, M2b §2b). Rendered by Terraform: region, bucket, queue URL,
# config.json and the rehearsal switches are filled in. Runs once per instance; pull_code.sh runs on
# every start. The worker's boot record (M2b §10) reads the step lines of this log: keep their text.
set -euo pipefail

LOG=/var/log/neurolens-boot.log
log() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $*" | tee -a "$LOG"; }
# A failed boot only logs: the machine never ends itself (M2b §2). With no worker running, the idle
# alarm and the circuit breaker end it and stop replacements within about 90 minutes.
trap 'log "FAILED at line $LINENO; waiting for the idle alarm and circuit breaker"' ERR

log "boot start"

# 2. Weights live on the fast local NVMe disk (instance store), never on the root disk.
CACHE=/opt/neurolens/cache
mkdir -p "$CACHE"
# Keep in step with build_ami.sh. The Deep Learning base image mounts the instance-store disk
# itself at boot (so mkfs is refused): reuse that mount when there is one.
DISK=$(lsblk -dno NAME,MODEL | awk '/Instance Storage/ {print "/dev/" $1; exit}')
if [ -z "$DISK" ]; then
  log "no instance-store disk (CPU rehearsal): using a folder on the root disk"
elif MNT=$(lsblk -nro MOUNTPOINT "$DISK" | grep -m1 .); then
  mount --bind "$MNT" "$CACHE"
  log "$DISK already mounted at $MNT by the base image: bound to $CACHE"
elif mkfs.ext4 -q -F "$DISK" && mount "$DISK" "$CACHE"; then
  log "formatted and mounted $DISK at $CACHE"
else
  log "could not use $DISK: using a folder on the root disk (slower)"
fi

# 3. Weights from S3 (through the free gateway endpoint). A fake-inference rehearsal needs none.
%{ if fake_inference ~}
log "fake inference: no weight sync"
%{ else ~}
log "weight sync start"
SECONDS=0
# Skip HuggingFace's blobs/: the snapshots/ files are full copies where offline loading looks, so
# blobs/ (also uploaded, as the S3 sync followed the snapshot symlinks) would double the download.
aws s3 sync "s3://${bucket}/models/" "$CACHE/" --region "${region}" --only-show-errors --exclude "*/blobs/*"
log "weight sync done in $SECONDS s"
%{ endif ~}

# 4. Settings. env.conf: deployment identifiers only (region, bucket, queue, database ARNs), no
# secrets (the database password stays in Secrets Manager); plus the
# offline switches: models and uvx's WhisperX environment come only from the image (UV_OFFLINE: M2b §8,
# else uvx rebuilds it with whatever PyPI has that day).
# config.json: the committed file with this machine's absolute paths (Terraform fills it in).
mkdir -p /opt/neurolens/app
umask 077
cat > /opt/neurolens/env.conf <<EOF
NEUROLENS_ROOT=/opt/neurolens/app
NEUROLENS_S3_BUCKET=${bucket}
NEUROLENS_SQS_QUEUE_URL=${queue_url}
NEUROLENS_AWS_REGION=${region}
NEUROLENS_WORKER_GROUP=${worker_group}
NEUROLENS_DB_CLUSTER_ARN=${db_cluster_arn}
NEUROLENS_DB_SECRET_ARN=${db_secret_arn}
NEUROLENS_DB_NAME=${db_name}
NEUROLENS_DEPLOYED=1
HF_HUB_OFFLINE=1
UV_OFFLINE=1
%{ if fake_inference ~}
FAKE_INFERENCE=1
FAKE_INFERENCE_SECONDS=${fake_job_seconds}
%{ endif ~}
EOF
cat > /opt/neurolens/app/config.json <<'EOF'
${config_json}
EOF
chmod 600 /opt/neurolens/env.conf /opt/neurolens/app/config.json
umask 022
log "settings written"

# 5. Code, then check the settings load before the service is allowed to start.
set -a
. /opt/neurolens/env.conf
set +a
/opt/neurolens/bin/pull_code.sh
test -s /opt/neurolens/env.conf
# The worker's own settings check, so a missing setting fails here, logged, not in a crash loop.
(cd /opt/neurolens/app && /opt/neurolens/venv/bin/python -c \
  "from neurolens.settings import load_settings; from neurolens.worker import validate_config; validate_config(load_settings())")
log "code $(cat /opt/neurolens/app/REVISION) pulled and settings verified"

# 6. Service changes as a drop-in, so they reach new workers without an image rebuild:
# - crash limit (M2a §3): 3 starts within an hour, then the service stays failed and the machine
#   waits for the idle alarm and circuit breaker. The window must outlast a crash cycle (each restart
#   reloads the model, ~3.5 min); systemd counts in fixed windows.
# - TimeoutStopSec: on SIGTERM the worker hands its job back within seconds; after 110 s systemd
#   kills it, and the heartbeat's end makes the job visible again within about 120 s.
# - KillMode=mixed: SIGTERM goes to the worker alone, not also to its helper programs (ffprobe,
#   WhisperX), so a helper killed first cannot make a stop look like a job failure. Python ends its
#   own helpers; any left when it exits (or at the 110 s limit) get SIGKILL.
mkdir -p /etc/systemd/system/neurolens-worker.service.d
cat > /etc/systemd/system/neurolens-worker.service.d/limits.conf <<'EOF'
[Unit]
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
TimeoutStopSec=110
KillMode=mixed
EOF
# Manual work is invisible to the queue-based rules (M2b §2). infra/debug_worker.sh refuses to open
# a shell without a warm hold; login shells on the machine (bash -l, sudo -i) show this reminder too.
cat > /etc/profile.d/neurolens-idle-alarm.sh <<'EOF'
case $- in *i*)  # interactive shells only, so scripted output stays clean
  echo
  echo "  NeuroLens worker: AWS ends this machine 15 minutes after the job queue empties, unless a warm"
  echo "  hold is on. For manual work, run infra/start_work.sh --keep-worker --hours N on your Mac first."
  echo ;;
esac
EOF
# The image's unit still names neurolens-self-terminate.service in OnSuccess=/OnFailure= (a drop-in
# cannot empty those lists): masking it means they start nothing (M2b §2b). The image installed that
# unit file in /etc/systemd/system, exactly where `mask` puts its /dev/null link, so the file goes
# first (mask refuses to overwrite it). Removed at the next image rebuild (M2a §12).
rm -f /etc/systemd/system/neurolens-self-terminate.service
systemctl mask neurolens-self-terminate.service
systemctl daemon-reload

# 7. Start the worker (disabled in the image until now).
systemctl enable --now neurolens-worker
log "worker started"
