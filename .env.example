# NeuroLens configuration. Copy to .env (git-ignored) and fill in.
# APP_ENV=dev runs the whole system on this machine (`make dev`); APP_ENV=aws is the deployed system
# and gets its values from CDK + Secrets Manager instead of this file.
APP_ENV=dev
# Where the browser reaches the app — the only two settings to change for LAN access.
# localhost (default) = this machine only. An IP (e.g. 192.168.0.17) = reachable on the LAN; the app URL,
# the browser's S3 upload URL and the bind address all follow from these two. Pick a port the firewall allows.
DEV_PUBLIC_HOST=localhost
DEV_WEB_PORT=8000

# ─── Database: Postgres container started by `make dev` ─────────────────────
DATABASE_URL=postgresql://neurolens:neurolens@localhost:5433/neurolens
DEV_PG_IMAGE=postgres:15
DEV_PG_PORT=5433

# ─── AWS stand-in: moto server (S3 + SQS). boto3 sends every call to AWS_ENDPOINT_URL. ─
AWS_ENDPOINT_URL=http://localhost:5055
AWS_ACCESS_KEY_ID=dev
AWS_SECRET_ACCESS_KEY=dev
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1
DEV_MOTO_PORT=5055
S3_BUCKET=neurolens-dev
SQS_QUEUE_URL=http://localhost:5055/123456789012/neurolens-jobs
SQS_DLQ_URL=http://localhost:5055/123456789012/neurolens-jobs-dlq

# ─── Web tier ───────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-me-to-a-long-random-string
DEV_LOGIN_ENABLED=true
STATIC_DIR=web/static
SAMPLES_JSON=data/samples.json
DATA_DIR=data
MIGRATIONS_DIR=migrations
# Google sign-in (optional in dev — dev sign-in works without it). Google only accepts http redirects on
# localhost: keep DEV_PUBLIC_HOST=localhost and register http://localhost:<DEV_WEB_PORT>/auth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stripe test mode (optional in dev). Webhook secret comes from `make dev-stripe`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── GPU worker ─────────────────────────────────────────────────────────────
# tribe = real TRIBE v2 on this machine's GPU (needs .venv-worker); mock = fake results, no GPU
INFERENCE_BACKEND=tribe
SILENT_MODE=ffmpeg
WORKER_PYTHON=.venv-worker/bin/python
# Weights already downloaded by the notebooks (16 GB). HF_HOME must point at the same folder.
MODELS_DIR=/home/kelvinlow/projects/neurolens/models
HF_HOME=/home/kelvinlow/projects/neurolens/models
HF_HUB_OFFLINE=1
# torch hub / torchaudio models (WhisperX alignment model) live next to the HF weights
TORCH_HOME=/home/kelvinlow/projects/neurolens/models/torch
NILEARN_DATA=data/nilearn
SCRATCH_DIR=.dev/scratch
# Only needed for `make download-weights` (gated LLaMA). Leave empty otherwise.
HF_TOKEN=

# ─── AI report (step after TRIBE: LLM summary → PDF) ────────────────────────
# openai = call the OpenAI API directly from this machine (needs OPENAI_API_KEY below)
# mock   = sample text, no key needed (layout preview)   ·   off = skip the report
# (AWS uses REPORT_LLM=bedrock — Claude via Amazon Bedrock — set by CDK, not here.)
REPORT_LLM=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
