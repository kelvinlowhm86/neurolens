# Copy to .env (git-ignored, per person) and fill in. Real environment variables win over this file.
# The infra/*.sh scripts do not read this file; they use the shell's NEUROLENS_AWS_PROFILE (see
# infra/terraform/README.md §0).
# Needed only to download the model from HuggingFace. Not needed by teammates working on a
# deployment whose model files are already in S3.
HF_TOKEN=hf_your_read_token_here
# M3j: YouTube Data API key for the retention-curve lookup (a secret from Google Cloud). Needed
# only to run the site on a laptop; the live site reads it from Parameter Store.
NEUROLENS_YOUTUBE_API_KEY=
# From `terraform output` (infra/terraform/README.md): deployment values, never in config.json.
NEUROLENS_AWS_REGION=us-east-1
NEUROLENS_S3_BUCKET=your-bucket-name
NEUROLENS_GPU_ENDPOINT=neurolens
# The AWS CLI profile the web app and experiment scripts use (a profile name, not a credential).
# The infra/*.sh scripts ignore this and read NEUROLENS_AWS_PROFILE from the shell instead.
AWS_PROFILE=neurolens
# M3a: Aurora through the Data API (from `terraform output`; identifiers, not secrets).
NEUROLENS_DB_CLUSTER_ARN=arn:aws:rds:us-east-1:YOUR_ACCOUNT_ID:cluster:your-cluster-name
NEUROLENS_DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:YOUR_ACCOUNT_ID:secret:your-secret-name
NEUROLENS_DB_NAME=neurolens
# Only with db.backend "postgres" on a laptop (it holds a password, so never in config.json):
# NEUROLENS_DB_DSN=postgresql://postgres:your-password@localhost:55432/postgres
